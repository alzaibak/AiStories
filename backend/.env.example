MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=islamic_stories
MYSQL_USER=root
MYSQL_PASSWORD=

PORT=5000
JWT_SECRET_KEY=replace-with-at-least-64-random-characters
OTP_HASH_SECRET=replace-with-a-different-64-random-characters

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Islamic Stories <no-reply@example.com>

# Clé requise uniquement pour migrer les anciens mots de passe chiffrés avant la migration 004.
SECRET_PASSWORD=

# Facultatif : base URL de l’application cliente.
CLIENT_DOMAIN=http://localhost:8080
CLIENT_APP_URL=http://localhost:8080

# Stripe Checkout and webhook secrets are required to accept payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOK_SHIPPING_FEE=
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Variables facultatives du seed.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PREVIOUS_EMAIL=old-admin@example.com
# SEED_ADMIN_DELETE_PREVIOUS=false
# SEED_ADMIN_PASSWORD=

# Bucket privé S3 ou compatible (MinIO). Les clés peuvent aussi venir du rôle IAM.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
