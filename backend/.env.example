MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=islamic_stories
MYSQL_USER=root
MYSQL_PASSWORD=

PORT=5000
JWT_SECRET_KEY=replace-with-at-least-64-random-characters
OTP_HASH_SECRET=replace-with-a-different-64-random-characters

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Islamic Stories <no-reply@example.com>

# Clé requise uniquement pour migrer les anciens mots de passe chiffrés avant la migration 004.
SECRET_PASSWORD=

# Facultatif : base URL de l’application cliente.
CLIENT_DOMAIN=http://localhost:8080
CLIENT_APP_URL=http://localhost:8080

# Stripe Checkout and webhook secrets are required to accept payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOK_SHIPPING_FEE=
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Variables facultatives du seed.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PREVIOUS_EMAIL=old-admin@example.com
# SEED_ADMIN_DELETE_PREVIOUS=false
# SEED_ADMIN_PASSWORD=

# Stockage privé : local par défaut hors production, S3 par défaut en production.
# local utilise backend/private_uploads, qui n'est jamais exposé comme fichier statique.
# Définissez STORAGE_LOCAL_DIRECTORY uniquement pour choisir un autre chemin privé.
STORAGE_DRIVER=local
STORAGE_MAX_UPLOAD_BYTES=20971520
# STORAGE_LOCAL_DIRECTORY=C:\private\islamic-stories-uploads

# Pour STORAGE_DRIVER=s3 : S3_BUCKET est requis. S3_REGION est facultatif
# (défaut us-east-1), S3_ENDPOINT est facultatif (R2/MinIO), les deux clés
# d'accès sont facultatives ensemble (rôle IAM possible) et
# S3_FORCE_PATH_STYLE est facultatif (activé automatiquement avec un endpoint).
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
