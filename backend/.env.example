MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=e_tendering
MYSQL_USER=root
MYSQL_PASSWORD=

PORT=5000
JWT_SECRET_KEY=replace-with-a-random-secret
OTP_HASH_SECRET=replace-with-a-different-random-secret

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MediTender <no-reply@example.com>

# Clé requise uniquement pour migrer les anciens mots de passe chiffrés avant la migration 004.
SECRET_PASSWORD=

# Facultatif : base URL de l’application cliente.
CLIENT_DOMAIN=http://localhost:8080

# Variables facultatives du seed (crée aussi les comptes de démonstration).
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PREVIOUS_EMAIL=old-admin@example.com
# SEED_ADMIN_DELETE_PREVIOUS=false
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# Bucket privé S3 ou compatible (MinIO). Les clés peuvent aussi venir du rôle IAM.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
